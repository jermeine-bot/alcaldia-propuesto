# Reglas de seguridad para Apache 2.4 (producción).
# En Nginx, replica estas reglas en la configuración del servidor.

Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "^(\.env.*|database\.sqlite|.*\.sqlite|.*\.sql|adminer\.php|start\.(sh|ps1|bat)|composer\.(json|lock)|phpunit\.xml)$">
        Require all denied
    </FilesMatch>
</IfModule>

# Los directorios internos no deben ser accesibles directamente.
RedirectMatch 404 ^/(config|controllers|middlewares|services|mysql|data)/

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always unset X-Powered-By
</IfModule>

<IfModule mod_php.c>
    php_flag expose_php Off
</IfModule>
